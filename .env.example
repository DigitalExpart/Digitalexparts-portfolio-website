# Site URL used for canonical metadata, sitemap, robots, and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://digital-expert.example.com

# Contact Form Delivery (configure either Resend OR Formspree)
# Option 1: Resend (recommended)
RESEND_API_KEY=
CONTACT_TO_EMAIL=[YOUR EMAIL]
CONTACT_FROM_EMAIL=Digital Expert <onboarding@resend.dev>

# Option 2: Formspree endpoint (used if RESEND_API_KEY is not set)
FORMSPREE_ENDPOINT=
